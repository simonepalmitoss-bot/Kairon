      "id": "177c73e9-13a6-46dc-a351-be507c60a7c6",
      "name": "Filter"
    },
    {
      "parameters": {
        "jsCode": "const norm = (v) =>\n  String(v ?? '')\n    .trim()\n    .toLowerCase()\n    .replace(/\\s+/g, ' ');\n\nconst escapeHtml = (v) =>\n  String(v ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n\nconst waitlist = $input.all().map((i) => i.json);\nconst carenzeAttuali = $('Filter').all().map((i) => i.json);\n\nconst daNotificare = [];\n\nfor (const row of waitlist) {\n  // Se esiste un campo di stato (es. stato / status), salta chi è già stato notificato o chiuso\n  const statoRaw = norm(row.stato ?? row.status ?? row.stato_attesa ?? '');\n  if (\n    statoRaw &&\n    ['notified', 'notificato', 'inviato', 'sent', 'done', 'chiuso', 'completed'].includes(statoRaw)\n  ) {\n    continue;\n  }\n\n  const cercato = norm(row.request ?? row.farmaco ?? '');\n  if (!cercato) continue;\n\n  const paroleCercate = cercato.split(/\\s+/).filter((p) => p.length >= 4);\n  const primaParola = cercato.split(/\\s+/)[0] || '';\n\n  const ancoraCarente = carenzeAttuali.some((item) => {\n    const nome = norm(item.nome_farmaco ?? item.farmaco ?? item.nome ?? '');\n    const pa = norm(item.principio_attivo ?? item.pa ?? '');\n\n    const matchNome =\n      Boolean(nome) &&\n      (nome === cercato ||\n        (cercato.length >= 4 && nome.includes(cercato)) ||\n        (nome.length >= 4 && cercato.includes(nome)) ||\n        (primaParola.length >= 5 && nome.includes(primaParola)) ||\n        (paroleCercate.length > 0 && paroleCercate.every((p) => nome.includes(p))));\n\n    const matchPa =\n      Boolean(pa) &&\n      (pa === cercato ||\n        (cercato.length >= 4 && pa.includes(cercato)) ||\n        (pa.length >= 4 && cercato.includes(pa)));\n\n    return matchNome || matchPa;\n  });\n\n  if (!ancoraCarente) {\n    const nomeRaw = String(row['First name'] ?? row.first_name ?? row.nome ?? '').trim();\n    const nomeCliente = nomeRaw ? ` ${escapeHtml(nomeRaw)}` : '';\n    const farmacoRaw = String(row.request ?? row.farmaco ?? '').trim();\n    const farmacoHtml = escapeHtml(farmacoRaw);\n\n    const testoMessaggio =\n      `Gentile${nomeCliente},\\n\\n` +\n      `Ti informiamo che il farmaco ${farmacoHtml} non risulta più presente nella lista ufficiale delle carenze AIFA ed è nuovamente disponibile.\\n\\n` +\n      `📌 Cosa puoi fare adesso?\\n` +\n      `• Prenotazione: Puoi contattarci o scriverci direttamente qui su Telegram per bloccare la tua confezione.\\n` +\n      `• Ritiro in sede: Puoi passare direttamente in farmacia per ritirare il farmaco (ricorda di portare l'eventuale ricetta medica).\\n\\n` +\n      `Restiamo a disposizione per qualsiasi chiarimento!\\n` +\n      `Farmacia`;\n\n    const chatId = row.chat_id ?? row.ID ?? row.id ?? '';\n\n    daNotificare.push({\n      json: {\n        ...row,\n        chat_id: chatId,\n        farmaco_disponibile: farmacoRaw,\n        messaggio_telegram: testoMessaggio\n      }\n    });\n  }\n}\n\nreturn daNotificare;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1536,
        1216
      ],
      "id": "cbfd0db5-d4d9-409f-9b2d-6dfd6c237bc1",
      "name": "Code"
    },
    {
      "parameters": {
        "jsCode": "// 1. Recupera tutte le righe presenti nella Waitlist\nconst righeWaitlist = $input.all().map(item => item.json);\nconst totaleRichieste = righeWaitlist.length || 0;\n\n// 2. Calcolo stime e metriche (4 minuti risparmiati a gestione)\nconst minutiTotali = totaleRichieste * 4;\nconst oreRisparmiate = (minutiTotali / 60).toFixed(1);\n\n// 3. Contatore progressivo del recap (RECAP 1, RECAP 2, ...)\nconst staticData = $getWorkflowStaticData('global');\nstaticData.recapCounter = (staticData.recapCounter || 0) + 1;\nconst numeroRecap = staticData.recapCounter;\n\n// 4. Data odierna in formato gg/mm/aaaa (fuso orario Europe/Rome)\nconst dataOggi = new Intl.DateTimeFormat('it-IT', {\n  timeZone: 'Europe/Rome',\n  day: '2-digit',\n  month: '2-digit',\n  year: 'numeric'\n}).format(new Date());\n\n// 5. Costruzione del messaggio formattato per Telegram\nconst testoReport = `📌 RECAP ${numeroRecap}\n\n👋 Ciao, ti invio il recap del ${dataOggi}\n\n📊 <b>Report Giornaliero Attività IA</b>\n\nEcco il riepilogo delle operazioni di oggi:\n\n• <b>Richieste totali in gestione:</b> ${totaleRichieste}\n• <b>Tempo stimato risparmiato:</b> ~${oreRisparmiate} ore (${minutiTotali} min)\n• <b>Stato sistema:</b> Monitoraggio AIFA attivo 🩺\n\n<i>⏳ Il sistema riprenderà le verifiche automatiche ed eventuali notifiche alle 20:00 di domani.</i>`;\n\nreturn [{\n  json: {\n    numero_recap: numeroRecap,\n    data_recap: dataOggi,\n    corpo_html: testoReport\n  }\n}];"
      },
